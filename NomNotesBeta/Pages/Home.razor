@page "/"
@using Markdig
@inject IJSRuntime JS

<PageTitle>NomNotes</PageTitle>

<div class="container mt-4" style="max-width: 800px;">

    @if (!isSubmitted)
    {
    <h1 class="mb-4">🌱 Daily Wellness Log</h1>
    <p class="text-muted"><b>Date:</b> @DateTime.Today.ToString("MMMM dd, yyyy")</p>

    <!-- SECTION 1: Morning & Hydration (Side by Side) -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">☀️ Morning Energy</h5>
                    <label class="form-label">How did you feel waking up? (1-5)</label>
                    <input type="range" class="form-range" min="1" max="5" @bind="dailyLog.WakeUpEnergy" />
                    <div class="d-flex justify-content-between text-muted small">
                        <span>Exhausted</span>
                        <span>Current: @dailyLog.WakeUpEnergy</span>
                        <span>Energized</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">💧 Hydration Tracker</h5>
                    <label class="form-label">Glasses of water today:</label>
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary" @onclick="() => { if (dailyLog.WaterGlasses > 0) dailyLog.WaterGlasses--; }">-</button>
                        <h3 class="mb-0">@dailyLog.WaterGlasses</h3>
                        <button class="btn btn-outline-primary" @onclick="() => dailyLog.WaterGlasses++">+</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 2: Food Tracker -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">🍽️ Meals</h5>
            
            <!-- Input Form -->
            <div class="row g-2 mb-4">
                <div class="col-md-3">
                    <select @bind="newEntry.MealType" class="form-select">
                        <option value="Breakfast">Breakfast</option>
                        <option value="Lunch">Lunch</option>
                        <option value="Dinner">Dinner</option>
                        <option value="Snack">Snack</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <input @bind="newEntry.FoodItem" class="form-control" placeholder="What did you eat?" />
                </div>
                <div class="col-md-3">
                    <input @bind="newEntry.Notes" class="form-control" placeholder="Notes (optional)" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" @onclick="AddFoodEntry">Add</button>
                </div>
            </div>

            <!-- Food Table -->
            @if (dailyLog.Meals.Any())
            {
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Meal</th>
                            <th>Food</th>
                            <th>Notes</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in dailyLog.Meals)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@item.MealType</span></td>
                                <td>@item.FoodItem</td>
                                <td>@item.Notes</td>
                                <td><i class="fa fa-trash-o" @onclick="() => RemoveMeal(item)"></i></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small">No meals logged yet today.</p>
            }
        </div>
    </div>

    <!-- SECTION 3: End of Day Notes -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">🌙 End of Day Notes</h5>
            <textarea @bind="dailyLog.EndOfDayNotes" class="form-control" rows="3" placeholder="How did today go? Any reflections or symptoms?"></textarea>
        </div>
    </div>
        <!-- The new Submit Button -->
        <div class="mt-4 mb-5">
            <button class="btn btn-primary w-100 btn-lg" @onclick="SubmitDay">✅ Complete & View Day</button>
        </div>
    }
    else
    {
        <!-- RESULTS VIEW -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">📝 Daily Summary</h2>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" @onclick="EditDay">✏️ Edit Log</button>
                <button class="btn btn-outline-primary" @onclick="CopyLog">📋 Copy</button>
                <button class="btn btn-danger" @onclick="DownloadPdf">📕 Download PDF</button>
            </div>
        </div>

        @if (copySuccess)
        {
            <div class="alert alert-success py-2">Copied to clipboard!</div>
        }

        <!-- The Generated HTML Preview -->
        <div class="card shadow-sm mb-5">
            <div class="card-body" style="font-family: Arial, sans-serif; line-height: 1.6;">
                @((MarkupString)previewHtml)
            </div>
        </div>
    }
</div>

@code {

    // 1. Data Models
    public class WellnessLog
    {
        public int WakeUpEnergy { get; set; } = 3;
        public int WaterGlasses { get; set; } = 0;
        public string EndOfDayNotes { get; set; } = string.Empty;
        public List<FoodEntry> Meals { get; set; } = new();
    }

    public class FoodEntry
    {
        public string MealType { get; set; } = "Breakfast";
        public string FoodItem { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }

    // 2. State Management
    private WellnessLog dailyLog = new();
    private FoodEntry newEntry = new();
    private bool isSubmitted = false;
    private bool copySuccess = false;
    private string rawMarkdown = string.Empty;
    private string previewHtml = string.Empty;

    // 3. Logic to Add Food
    private void AddFoodEntry()
    {
        if (!string.IsNullOrWhiteSpace(newEntry.FoodItem))
        {
            dailyLog.Meals.Add(new FoodEntry
            {
                MealType = newEntry.MealType,
                FoodItem = newEntry.FoodItem,
                Notes = newEntry.Notes
            });

            // Reset food item but keep meal type
            newEntry = new() { MealType = newEntry.MealType };
        }
    }

    private void RemoveMeal(FoodEntry meal)
    {
        dailyLog.Meals.Remove(meal);
    }

    // 4. Generate and Download Markdown & PDF
    // Helper method to generate the raw Markdown text
    private string GetMarkdownString()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# Wellness Log - {DateTime.Today:yyyy-MM-dd}\n");
        
        sb.AppendLine("## 📊 Daily Metrics");
        sb.AppendLine($"- **Morning Energy Level:** {dailyLog.WakeUpEnergy}/5");
        sb.AppendLine($"- **Hydration:** {dailyLog.WaterGlasses} glasses of water\n");

        sb.AppendLine("## 🍽️ Food Log");
        var mealTypes = new[] { "Breakfast", "Lunch", "Dinner", "Snack" };
        
        foreach (var meal in mealTypes)
        {
            var mealItems = dailyLog.Meals.Where(x => x.MealType == meal).ToList();
            if (mealItems.Any())
            {
                sb.AppendLine($"### {meal}");
                foreach (var item in mealItems)
                {
                    var noteStr = string.IsNullOrWhiteSpace(item.Notes) ? "" : $" *(Note: {item.Notes})*";
                    sb.AppendLine($"- {item.FoodItem}{noteStr}");
                }
                sb.AppendLine();
            }
        }

        if (!string.IsNullOrWhiteSpace(dailyLog.EndOfDayNotes))
        {
            sb.AppendLine("## 🌙 End of Day Notes");
            sb.AppendLine(dailyLog.EndOfDayNotes);
        }

        return sb.ToString();
        // return "# Sample Log\n\n- Example text..."; // Replace with your actual StringBuilder logic
    }
    private void SubmitDay()
    {
        // 1. Generate the Markdown based on current inputs
        rawMarkdown = GetMarkdownString();

        // 2. Convert it to HTML immediately for the preview screen
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        previewHtml = Markdown.ToHtml(rawMarkdown, pipeline);

        // 3. Switch the UI state
        isSubmitted = true;
        copySuccess = false; // Reset copy alert
    }

    private void EditDay()
    {
        // Switches the UI back to the form so the user can make changes
        isSubmitted = false;
    }
    private async Task CopyLog()
    {
        // We pass BOTH the pretty HTML and the raw Markdown (as a backup) to JavaScript
        var success = await JS.InvokeAsync<bool>("copyRichTextToClipboard", previewHtml, rawMarkdown);
    
        if (success)
        {
            copySuccess = true;
            StateHasChanged();
        
            await Task.Delay(3000);
            copySuccess = false;
            StateHasChanged();
        }
    }

    private async Task DownloadPdf()
    {
        // Pass the HTML directly to our new print function
        await JS.InvokeVoidAsync("printHtmlAsPdf", previewHtml);
    }
}
}
